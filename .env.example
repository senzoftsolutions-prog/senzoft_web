VITE_SITE_URL=https://www.example.com
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Django backend (copy to .env and replace placeholders with real values)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require
AWS_ACCESS_KEY_ID=replace-with-access-key
AWS_SECRET_ACCESS_KEY=replace-with-secret-key
AWS_ENDPOINT_URL_S3=https://replace-with-storage-endpoint
AWS_REGION=ap-southeast-1
CANDIDATE_DOCUMENTS_BUCKET=candidate-documents
RECRUITMENT_EMAIL=careers@example.com
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_SETTINGS_MODULE=config.settings.development
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Zoho ZeptoMail / CPaaS (select the endpoint for your account region)
EMAIL_PROVIDER=zeptomail
EMAIL_HOST=smtp.zeptomail.in
EMAIL_PORT=587
EMAIL_HOST_USER=emailapikey
EMAIL_HOST_PASSWORD=replace-with-the-smtp-password-from-zoho
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
ZEPTOMAIL_API_URL=https://cpaas.zoho.in/v1.1/email
ZEPTOMAIL_API_KEY=Zoho-enczapikey replace-with-the-send-api-key
DEFAULT_FROM_EMAIL=Senzoft Software Solutions <careers@example.com>
EMAIL_LOGO_URL=https://www.example.com/media/senzoftweblogo-transparent.png
EMAIL_TIMEOUT=15
CONTACT_RECIPIENT_EMAIL=contact@example.com
CONTACT_FROM_EMAIL=Example Website <careers@example.com>

AI_SERVICE_URL=
AI_SERVICE_TOKEN=
AI_PROVIDER=native
AI_MODEL=gpt-5-mini
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:7b
AUTO_CREATE_AI_SCREENING=false
AI_INTERVIEW_EXPIRY_DAYS=7
