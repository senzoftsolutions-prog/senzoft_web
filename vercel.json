{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python -m pip install -r requirements.txt && python backend/manage.py migrate --noinput --settings=config.settings.production && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/v1/(.*)", "destination": "/api/index.py" },
    { "source": "/health/", "destination": "/api/index.py" },
    { "source": "/django-admin/(.*)", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
